{
  "manifest_version": 3,
  "name": "Tab Volume Dial",
  "version": "1.4.1",
  "description": "Per-tab volume up to 1000%, with a five-band EQ, audio leveling, and peak protection.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Tab Volume Dial",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "author": "Aimplify Solutions LLC",
  "homepage_url": "https://aimplifysolutions.com/"
}
